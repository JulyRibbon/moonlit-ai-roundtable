{
  "name": "moonlit-ai-roundtable",
  "version": "0.5.1",
  "private": true,
  "description": "本机多 AI 聊天室：不同客户端的原生会话入座，房间只负责传话、排程、字幕和记录。",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test",
    "start": "node server/live.mjs",
    "start:all": "node scripts/start-all.mjs",
    "demo": "node server/demo.mjs",
    "probe:dsh:list": "node probes/dsh/probe-list.mjs",
    "probe:dsh:run": "node probes/dsh/probe-run.mjs",
    "probe:kimi:list": "node probes/kimi-code/probe-list.mjs",
    "probe:kimi:meta": "node probes/kimi-code/probe-meta.mjs",
    "probe:kimi:ws": "node probes/kimi-code/probe-ws.mjs",
    "probe:zcode:version": "node probes/zcode/probe-version.mjs",
    "probe:zcode:meta": "node probes/zcode/probe-meta.mjs",
    "probe:qwen:meta": "node probes/qwen-code/probe-meta.mjs",
    "probe:qwen:api": "node probes/qwen-code/probe-api.mjs",
    "setup:qwen-seat": "node scripts/setup-qwen-seat.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "js-yaml": "^4.3.2"
